# Copier ce fichier en .env puis remplir. Ne JAMAIS committer .env.

# --- Modèle (tool calling natif obligatoire) ---
# gemini | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=
# Si LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Boucle de l'agent ---
MAX_STEPS=8
MAX_TOOL_CALLS_PER_TURN=4
LLM_RETRIES=3

# --- Outils ---
# mock       : tout est simulé (développement, tests)
# hybrid     : catalogue simulé + VRAI Calendar/Gmail (test réel sans le serveur MCP)
# integrated : vrai catalogue (MCP) + vrais Calendar/Gmail
TOOLS_MODE=mock
# Catalogue MCP (catalog/server.py, serveur stdio) :
MCP_TRANSPORT=stdio
# Python où `mcp` est installé (ex. .venv/bin/python sur Mac/Linux, python sous Windows)
MCP_COMMAND=python
MCP_ARGS=-m catalog.server
# MCP_CWD=        (défaut : racine du dépôt, où se trouve catalog/)
# Pour un serveur HTTP : MCP_TRANSPORT=streamable_http et MCP_URL=http://localhost:8000/mcp
# Module Python de Baye Serigne exposant get_google_tools() (dossier google_integration/ à la racine)
GOOGLE_TOOLS_MODULE=google_integration.google_tools
# Facultatif : par défaut google_integration/token.json, agenda « primary », libellé « à traiter »
# GOOGLE_TOKEN_PATH=
# GOOGLE_CALENDAR_ID=primary
# GMAIL_LABEL_A_TRAITER=à traiter
# GMAIL_LABEL_EN_ATTENTE=en attente de validation
# GMAIL_LABEL_REPONDU=répondu
# GMAIL_LABEL_TRANSMIS=transmis à un conseiller

# --- Validation vocale (option --voix, macOS) ---
# Voix de `say` (liste : say -v '?'), modèle Gemini de transcription (vide = LLM_MODEL), durée max d'une réponse
# VOICE_NAME=Thomas
# VOICE_STT_MODEL=
# VOICE_MAX_SECONDS=12

# --- Divers ---
DATA_DIR=data
TRACE_DIR=traces
TIMEZONE=Africa/Dakar

LLM_TIMEOUT_SECONDS=60
